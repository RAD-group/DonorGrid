# Copy this file to .env (git ignores .env) and fill in your own values.
# Never commit real values.

# Backend (Spring Boot)
DB_URL=jdbc:postgresql://localhost:5432/bloodbank
DB_USERNAME=blooduser
DB_PASSWORD=change-me
# At least 32 random characters, e.g. the output of: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters
ML_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ML service (FastAPI). Optional: the chat falls back to built-in answers without it.
HF_API_KEY=
